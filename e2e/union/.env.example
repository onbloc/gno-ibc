# Required live topology. Copy values from the confirmed Union EVM deployment.
UNION_CHAIN_ID=union-devnet-1
EVM_CHAIN_ID=
GNO_CHAIN_ID=dev.ibc

# Pinned Voyager runtime image. Build or pull it with ensure-image.sh.
UNION_VOYAGER_REVISION=82c70ec1ff84ec457e976ad94f38a5d5783b7836
# Optional local/GHCR image; the local tag below is the default.
# VOYAGER_IMAGE=union-voyager-e2e:82c70ec1ff84
# Optional Gno image consumed by gno-compose.yml.
# GNO_IMAGE=gno-ibc-e2e-gno:local
VOYAGER_RUST_LOG=warn
# E2E_TIMEOUT_SECONDS=900
# E2E_POLL_SECONDS=2
# VOYAGER_COMMAND_TIMEOUT_SECONDS=120
# VOYAGER_EVM_REFRESH_SECONDS=60
# VOYAGER_STOP_TIMEOUT_SECONDS=10
# E2E_CLEANUP_TIMEOUT_SECONDS=30

# Public deployed contracts/realms
UNION_IBC_HOST_CONTRACT=union1nk3nes4ef6vcjan5tz6stf9g8p08q2kgqysx6q5exxh89zakp0msq5z79t
EVM_IBC_HANDLER=
EVM_MULTICALL=
EVM_COMETBLS_CLIENT_IMPL=
EVM_PROOF_LENS_CLIENT_IMPL=
GNO_IBC_CORE_REALM=gno.land/r/onbloc/ibc/union/core
GNO_ZKGM_PORT=gno.land/r/onbloc/ibc/union/apps/ucs03_zkgm
EVM_ZKGM_CONTRACT=
GALOIS_PROVER_ENDPOINT=https://galois.union.build:443

# Optional --erc20-to-gno packet phase. Use a predeployed mint(address,uint256)
# test token; the amount is in 18-decimal units and must be divisible by 10^12.
EVM_TEST_ERC20=
GNO_RECIPIENT=
EVM_TEST_AMOUNT=1000000000000

# Required endpoints. Disposable CI defaults are declared in devnet.json.
UNION_RPC_URL=
EVM_RPC_URL=
GNO_RPC_URL=
GNO_TX_INDEXER_RPC_URL=
# Optional host-side overrides for packet scenarios when Voyager uses Docker-only URLs.
UNION_PACKET_RPC_URL=
EVM_PACKET_RPC_URL=
GNO_PACKET_RPC_URL=
GNO_PACKET_INDEXER_RPC_URL=
VOYAGER_DATABASE_URL=

# Required 0x-prefixed 32-byte raw private keys. The disposable local fixtures
# are public in devnet.json; never use them on another network.
TRUSTED_MPT_PRIVATE_KEY=
UNION_PRIVATE_KEY=
EVM_PRIVATE_KEY=
GNO_PRIVATE_KEY=

# Sanitized output. The state file is used by --resume and must remain mode 0600.
E2E_ARTIFACT_DIR=./channel-e2e-artifacts
E2E_STATE_FILE=./channel-e2e-artifacts/state.json
