// PKGPATH: gno.land/r/aib/main
package main

// recv_forward_ack_resolved_success_filetest covers the half of issue #248's
// design that recv_forward_ack_pending_filetest.gno explicitly excludes: once
// the onward leg settles, the registered forward handler calls
// transfer.CompleteForwardAck to resolve the deferred AtomOne packet ack.
//
// This uses a trivial mock ForwardHandler (no ZKGM involved at all - the
// decoupling means CompleteForwardAck's own logic can be proven in isolation)
// to reach the pending state, then simulates the onward leg succeeding.
// See recv_forward_ack_resolved_failure_filetest.gno for the burn/error-ack case.

import (
	"chain/runtime/unsafe"
	"encoding/hex"
	"time"

	tmtesting "gno.land/p/aib/ibc/lightclient/tendermint/testing"
	"gno.land/p/aib/ibc/types"
	"gno.land/p/aib/ics23"
	"gno.land/p/nt/ufmt/v0"
	"gno.land/r/aib/ibc/apps/transfer"
	"gno.land/r/aib/ibc/core"
)

const timeoutTimestamp = uint64(1234571490)

// mockHandler is a trivial transfer.ForwardHandler: it always accepts and
// does nothing on Execute, since this test only cares about
// CompleteForwardAck's own resolution logic, not any onward protocol.
type mockHandler struct{}

func (mockHandler) Prepare(cur realm, req transfer.Request) error { return nil }
func (mockHandler) Execute(cur realm, req transfer.Request)       {}

func main(cur realm) {
	// transfer.admin inits empty in the test framework, but by the time this
	// runs, unsafe.OriginCaller() is the framework's default non-empty test
	// address - claim admin as that address (SetAdmin allows this while
	// admin is still empty) so RegisterForwardHandler's admin check passes.
	transfer.SetAdmin(cross(cur), unsafe.OriginCaller())
	transfer.RegisterForwardHandler(cross(cur), mockHandler{})
	handlerAddr := transfer.ForwardHandlerAddress().String()
	println("[INFO] mock forward handler addr:", handlerAddr)

	var (
		chainID        = "chainA-2"
		trustedHeight  = types.NewHeight(2, 2)
		clientState    = tmtesting.NewClientState(chainID, trustedHeight)
		apphash, _     = hex.DecodeString("0b65f46cc9c71d72a2041eb1d8b980039a3af4c958b64975539767928553cafe")
		trustedValset  = tmtesting.GenValset()
		consensusState = tmtesting.GenConsensusState(time.Now(), apphash, trustedValset.Hash())
		counterpartyID = "07-tendermint-42"
	)
	clientID := core.CreateClient(cross(cur), clientState, consensusState)
	core.RegisterCounterparty(cross(cur), clientID, [][]byte{[]byte("iavlStoreKey"), []byte("prefix2")}, counterpartyID)

	println("[INFO] atomone client:", clientID)

	memo := `{"forward":{"channel":1,"receiver":"0xaabbccdd","quote_token":"0x11223344","metadata":{"implementation":"0x01","initializer":"0x02"}}}`
	payload := transfer.NewFungibleTokenPacketData("uatone", "100", "atone1sender", handlerAddr, memo)
	payloadBz := payload.ProtoMarshal()

	println("[INFO] payload proto hex:", hex.EncodeToString(payloadBz))

	voucherDenom := transfer.NewDenom("uatone", transfer.NewHop(transfer.PortID, clientID)).IBCDenom()

	specs := ics23.IavlSpec()
	recvPacket := types.MsgRecvPacket{
		Packet: types.Packet{
			Sequence:          1,
			SourceClient:      counterpartyID,
			DestinationClient: clientID,
			TimeoutTimestamp:  timeoutTimestamp,
			Payloads: []types.Payload{{
				SourcePort:      transfer.PortID,
				DestinationPort: transfer.PortID,
				Encoding:        transfer.EncodingProtobuf,
				Value:           payloadBz,
				Version:         transfer.V1,
			}},
		},
		// NOTE proof generated by:
		// go run -C ./cmd/gen-proof . 'prefix2' '07-tendermint-42' 'packet' '{"sequence":1,"source_client":"07-tendermint-42","destination_client":"07-tendermint-1","timeout_timestamp":1234571490,"payloads":[{"source_port":"transfer","destination_port":"transfer","encoding":"application/x-protobuf","value":"CgZ1YXRvbmUSAzEwMBoMYXRvbmUxc2VuZGVyIihnMWdqczhuZmRyZDU1ejN4dTlnamNhdG5qMjl2a3d1eXg0ZmZxeGQ5KoYBeyJmb3J3YXJkIjp7ImNoYW5uZWwiOjEsInJlY2VpdmVyIjoiMHhhYWJiY2NkZCIsInF1b3RlX3Rva2VuIjoiMHgxMTIyMzM0NCIsIm1ldGFkYXRhIjp7ImltcGxlbWVudGF0aW9uIjoiMHgwMSIsImluaXRpYWxpemVyIjoiMHgwMiJ9fX0=","version":"ics20-1"}]}'
		ProofCommitment: []ics23.CommitmentProof{
			// iavl proof
			ics23.CommitmentProof_Exist{
				Exist: &ics23.ExistenceProof{
					Key:   []byte("\x70\x72\x65\x66\x69\x78\x32\x30\x37\x2d\x74\x65\x6e\x64\x65\x72\x6d\x69\x6e\x74\x2d\x34\x32\x01\x00\x00\x00\x00\x00\x00\x00\x01"),
					Value: []byte("\xec\xc9\xb6\x5b\x7e\x7e\x3e\x37\x02\xb9\x32\x2b\x98\x42\x5b\xc1\xbc\x94\x2b\x24\x44\x6c\xc5\x9e\x9c\xa5\x6a\xc8\x29\xa0\xe1\x1c"),
					Leaf: &ics23.LeafOp{
						Hash:         specs.LeafSpec.Hash,
						PrehashKey:   specs.LeafSpec.PrehashKey,
						PrehashValue: specs.LeafSpec.PrehashValue,
						Length:       specs.LeafSpec.Length,
						Prefix:       []byte("\x00\x02\x02"),
					},
					Path: []*ics23.InnerOp{
						{
							Hash:   specs.InnerSpec.Hash,
							Prefix: []byte("\x02\x04\x02\x20\x35\xf8\xea\x80\x53\x90\xe0\x84\x85\x4f\x39\x9b\x42\xcc\xde\xae\xa3\x3a\x1d\xed\xc1\x15\x63\x8a\xc4\x8d\x06\x00\x63\x7d\xba\x1f\x20"),
							Suffix: []byte(""),
						},
						{
							Hash:   specs.InnerSpec.Hash,
							Prefix: []byte("\x04\x08\x02\x20"),
							Suffix: []byte("\x20\x79\x8e\x2c\xaa\x96\xfd\xfb\xa3\x76\xdd\xeb\x47\x99\x99\x54\xd2\xf4\x7e\x65\x16\x22\x64\xb0\x53\x6a\xb5\xdf\xf7\xfc\x0a\x2e\x07"),
						},
						{
							Hash:   specs.InnerSpec.Hash,
							Prefix: []byte("\x06\x0c\x02\x20\x9a\xf3\x7d\xd5\x95\xa0\x19\x08\x03\xb5\xe0\x5a\xae\xf4\x2a\xe3\xfa\xd4\x99\xe4\xfb\xe3\x7f\x7c\xd3\x1c\xad\xff\x22\xa9\xee\x74\x20"),
							Suffix: []byte(""),
						},
					},
				},
			},
			// rootmulti proof
			ics23.CommitmentProof_Exist{
				Exist: &ics23.ExistenceProof{
					Key:   []byte("\x69\x61\x76\x6c\x53\x74\x6f\x72\x65\x4b\x65\x79"),
					Value: []byte("\x65\x84\x4f\xb5\xde\x8c\xea\xa5\x4c\xe9\x4c\x01\x66\x7d\xbf\x35\x83\x5c\xd0\x31\xe1\x8f\x98\x12\x2b\x3f\xb8\xfa\x68\xcb\xa4\x08"),
					Leaf: &ics23.LeafOp{
						Hash:         specs.LeafSpec.Hash,
						PrehashKey:   specs.LeafSpec.PrehashKey,
						PrehashValue: specs.LeafSpec.PrehashValue,
						Length:       specs.LeafSpec.Length,
						Prefix:       []byte("\x00"),
					},
					Path: []*ics23.InnerOp{},
				},
			},
		},
		ProofHeight: trustedHeight,
	}
	recvRes := core.RecvPacket(cross(cur), recvPacket)
	if recvRes != types.RESPONSE_SUCCESS {
		panic("expected recv success")
	}
	println("[INFO] recv res:", recvRes)

	ufmt.Printf("[INFO] handler voucher balance after recv: %d\n", transfer.VoucherBalanceOf(voucherDenom, transfer.ForwardHandlerAddress()))
	ufmt.Println("[EXPECTED] should be 100 (minted to the handler, not escrowed onward by this trivial mock)")

	println("[INFO] atomone packet ack before resolve (should be pending):", core.Render("clients/"+clientID+"/packet_acknowledgements/1"))

	// Simulate the onward leg succeeding: the registered handler resolves the
	// deferred ack. This runs as the same realm that registered as the
	// handler, satisfying CompleteForwardAck's caller check.
	transfer.CompleteForwardAck(cross(cur), clientID, 1, true)

	println("[INFO] atomone packet ack after resolve (should be a real success ack):", core.Render("clients/"+clientID+"/packet_acknowledgements/1"))
}

// Output:
// [INFO] mock forward handler addr: g1gjs8nfdrd55z3xu9gjcatnj29vkwuyx4ffqxd9
// [INFO] atomone client: 07-tendermint-1
// [INFO] payload proto hex: 
// [INFO] recv res: (2 gno.land/p/aib/ibc/types.ResponseResultType)
// [INFO] handler voucher balance after recv: 100
// [EXPECTED] should be 100 (minted to the handler, not escrowed onward by this trivial mock)
// [INFO] atomone packet ack before resolve (should be pending): {"error":"sequence 1 not found"}
// [INFO] atomone packet ack after resolve (should be a real success ack): {"sequence":"1","data":"hGDiH3O1PXeeSzKRzTUzjpL66ZmHNfGgtxUMB0wHMaY="}
