package mpt

import (
	"bytes"
	"crypto/keccak256"
	"errors"
	"testing"

	"gno.land/p/onbloc/encoding/rlp"
)

func TestEmptyRoot(t *testing.T) {
	root := EmptyRoot()
	want := keccak256.Sum256(rlp.EncodeBytes(nil))
	if !bytes.Equal(root[:], want[:]) {
		t.Fatalf("EmptyRoot: got %x want %x", root, want)
	}
}

func TestVerify(t *testing.T) {
	value := []byte("dog")
	leaf := rawNode(leafPath([]byte{0x0a, 0x0b}), rlp.EncodeBytes(value))
	root := hash(leaf)

	tests := []struct {
		name  string
		root  []byte
		key   []byte
		value []byte
		proof [][]byte
		err   error
	}{
		{name: "matching leaf", root: root[:], key: []byte{0xab}, value: value, proof: [][]byte{leaf}},
		{name: "wrong key", root: root[:], key: []byte{0xac}, value: value, proof: [][]byte{leaf}, err: ErrKeyAbsent},
		{name: "wrong value", root: root[:], key: []byte{0xab}, value: []byte("cat"), proof: [][]byte{leaf}, err: ErrValueMismatch},
		{name: "empty root", root: hashBytes(rlp.EncodeBytes(nil)), key: []byte{0xab}, value: []byte("dog"), err: ErrKeyAbsent},
		{name: "invalid root length", root: []byte{0x01}, key: []byte{0xab}, value: value, err: ErrInvalidRoot},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if err := Verify(tt.root, tt.key, tt.value, tt.proof); !errors.Is(err, tt.err) {
				t.Fatalf("Verify: got %v want %v", err, tt.err)
			}
		})
	}
}

func TestVerifyAbsence(t *testing.T) {
	value := []byte("dog")
	leaf := rawNode(leafPath([]byte{0x0a, 0x0b}), rlp.EncodeBytes(value))
	root := hash(leaf)

	children := emptyBranch()
	branch := rlp.EncodeList(children...)
	branchRoot := hash(branch)

	tests := []struct {
		name  string
		root  []byte
		key   []byte
		proof [][]byte
		err   error
	}{
		{name: "leaf path mismatch", root: root[:], key: []byte{0xac}, proof: [][]byte{leaf}},
		{name: "present key", root: root[:], key: []byte{0xab}, proof: [][]byte{leaf}, err: ErrKeyPresent},
		{name: "empty branch child", root: branchRoot[:], key: []byte{0xab}, proof: [][]byte{branch}},
		{name: "empty root", root: hashBytes(rlp.EncodeBytes(nil)), key: []byte{0xab}},
		{name: "invalid root length", root: []byte{0x01}, key: []byte{0xab}, err: ErrInvalidRoot},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if err := VerifyAbsence(tt.root, tt.key, tt.proof); !errors.Is(err, tt.err) {
				t.Fatalf("VerifyAbsence: got %v want %v", err, tt.err)
			}
		})
	}
}

// TestVerifyGethEmbeddedNodeFixture pins the embedded-node fix against a real
// go-ethereum-produced proof (not hand-rolled RLP): an extension whose child
// is an embedded branch, whose children are in turn embedded leaves.
// Generated by /tools/gen-ethereum-embedded-node-proof-fixture/main.go.
func TestVerifyGethEmbeddedNodeFixture(t *testing.T) {
	root := mustHex("57d6fb096ab7e50322a93a19acb19cb091c364b3d57c376c40cd041979e9edd0")
	proof := [][]byte{
		mustHex("f839a000abababababababababababababababababababababababababababababababd780c23001c23002c2300380808080808080808080808080"),
	}

	keys := [][]byte{
		mustHex("ababababababababababababababababababababababababababababababab10"),
		mustHex("ababababababababababababababababababababababababababababababab20"),
		mustHex("ababababababababababababababababababababababababababababababab30"),
	}
	values := [][]byte{{0x01}, {0x02}, {0x03}}

	for i := range keys {
		if err := Verify(root, keys[i], values[i], proof); err != nil {
			t.Fatalf("Verify embedded fixture key%d: %v", i+1, err)
		}
	}

	missingKey := mustHex("ababababababababababababababababababababababababababababababab40")
	if err := VerifyAbsence(root, missingKey, proof); err != nil {
		t.Fatalf("VerifyAbsence embedded fixture: %v", err)
	}
}

func TestIsDataNode(t *testing.T) {
	tests := []struct {
		name string
		v    rlp.Value
		want bool
	}{
		{name: "byte", v: rlp.Value{Kind: rlp.KindByte, Bytes: []byte{0x7f}}, want: true},
		{name: "string", v: rlp.Value{Kind: rlp.KindString, Bytes: []byte("dog")}, want: true},
		{name: "list", v: rlp.Value{Kind: rlp.KindList, List: []rlp.Value{}}, want: false},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if got := isDataNode(tt.v); got != tt.want {
				t.Fatalf("isDataNode: got %v want %v", got, tt.want)
			}
		})
	}
}

func TestVerifyProof(t *testing.T) {
	longValue := bytes.Repeat([]byte{0x77}, 64)
	hashedLeaf := rawNode(leafPath([]byte{0x0b}), rlp.EncodeBytes(longValue))
	hashedLeafRef := hash(hashedLeaf)
	hashedBranchChildren := emptyBranch()
	hashedBranchChildren[0x0a] = rlp.EncodeBytes(hashedLeafRef[:])
	hashedBranch := rlp.EncodeList(hashedBranchChildren...)

	// Embedded nodes are spliced in raw (a nested list), not re-wrapped as an RLP string.
	embeddedValue := []byte("ok")
	embeddedLeaf := rawNode(leafPath([]byte{0x03, 0x04}), rlp.EncodeBytes(embeddedValue))
	embeddedExt := rawNode(extensionPath([]byte{0x01, 0x02}), embeddedLeaf)

	embeddedBranchLeaf := rawNode(leafPath([]byte{0x03, 0x04, 0x05}), rlp.EncodeBytes(embeddedValue))
	embeddedBranchChildren := emptyBranch()
	embeddedBranchChildren[0x0a] = embeddedBranchLeaf
	embeddedBranch := rlp.EncodeList(embeddedBranchChildren...)

	emptyExtChild := rawNode(extensionPath([]byte{0x0a, 0x0b}), rlp.EncodeBytes(nil))

	shortRefChild := branchWithChild(0, rlp.EncodeBytes([]byte{0x01, 0x02, 0x03, 0x04, 0x05}))

	singleValue := []byte("dog")
	singleLeaf := rawNode(leafPath([]byte{0x0a, 0x0b}), rlp.EncodeBytes(singleValue))

	badRoot := hash(hashedBranch)
	badRoot[0] ^= 0xff

	tests := []struct {
		name      string
		root      []byte
		key       []byte
		proof     [][]byte
		wantFound bool
		wantValue []byte
		err       error
	}{
		{name: "single leaf", root: hashBytes(singleLeaf), key: []byte{0xab}, proof: [][]byte{singleLeaf}, wantFound: true, wantValue: singleValue},
		{name: "leaf path mismatch", root: hashBytes(singleLeaf), key: []byte{0xac}, proof: [][]byte{singleLeaf}},
		{name: "embedded extension leaf", root: hashBytes(embeddedExt), key: []byte{0x12, 0x34}, proof: [][]byte{embeddedExt}, wantFound: true, wantValue: embeddedValue},
		{name: "embedded branch child", root: hashBytes(embeddedBranch), key: []byte{0xa3, 0x45}, proof: [][]byte{embeddedBranch}, wantFound: true, wantValue: embeddedValue},
		{name: "extension child is empty", root: hashBytes(emptyExtChild), key: []byte{0xab}, proof: [][]byte{emptyExtChild}},
		{name: "branch child invalid length reference", root: hashBytes(shortRefChild), key: []byte{0x00}, proof: [][]byte{shortRefChild}, err: ErrInvalidReference},
		{name: "hashed branch child", root: hashBytes(hashedBranch), key: []byte{0xab}, proof: [][]byte{hashedBranch, hashedLeaf}, wantFound: true, wantValue: longValue},
		{name: "extra unreferenced proof node is tolerated", root: hashBytes(hashedBranch), key: []byte{0xab}, proof: [][]byte{hashedBranch, hashedLeaf, singleLeaf}, wantFound: true, wantValue: longValue},
		{name: "empty branch child", root: hashBytes(rlp.EncodeList(emptyBranch()...)), key: []byte{0xab}, proof: [][]byte{rlp.EncodeList(emptyBranch()...)}},
		{name: "non-empty root without proof", root: hashBytes(singleLeaf), key: []byte{0xab}, err: ErrMissingNode},
		{name: "bad root", root: badRoot[:], key: []byte{0xab}, proof: [][]byte{hashedBranch, hashedLeaf}, err: ErrMissingNode},
		{name: "missing hashed child", root: hashBytes(hashedBranch), key: []byte{0xab}, proof: [][]byte{hashedBranch}, err: ErrMissingNode},
		{name: "hashed child mismatch", root: hashBytes(hashedBranch), key: []byte{0xab}, proof: [][]byte{hashedBranch, rawNode(leafPath([]byte{0x0b}), rlp.EncodeBytes([]byte("wrong")))}, err: ErrMissingNode},
		{name: "root is string", root: hashBytes(rlp.EncodeBytes([]byte("not-list"))), key: []byte{0xab}, proof: [][]byte{rlp.EncodeBytes([]byte("not-list"))}, err: ErrUnexpectedNode},
		{name: "branch value is list", root: hashBytes(branchWithValue(rlp.EncodeList())), key: []byte{}, proof: [][]byte{branchWithValue(rlp.EncodeList())}, err: ErrUnexpectedNode},
		{name: "branch child is list", root: hashBytes(branchWithChild(0, rlp.EncodeList())), key: []byte{0x00}, proof: [][]byte{branchWithChild(0, rlp.EncodeList())}, err: ErrUnexpectedNode},
		{name: "extension path is list", root: hashBytes(rlp.EncodeList(rlp.EncodeList(), rlp.EncodeBytes(nil))), key: []byte{0xab}, proof: [][]byte{rlp.EncodeList(rlp.EncodeList(), rlp.EncodeBytes(nil))}, err: ErrUnexpectedNode},
		{name: "leaf value is list", root: hashBytes(rawNode(leafPath(nil), rlp.EncodeList())), key: []byte{}, proof: [][]byte{rawNode(leafPath(nil), rlp.EncodeList())}, err: ErrUnexpectedNode},
		{name: "list has unsupported length", root: hashBytes(rlp.EncodeList(rlp.EncodeBytes(nil))), key: []byte{0xab}, proof: [][]byte{rlp.EncodeList(rlp.EncodeBytes(nil))}, err: ErrUnexpectedNode},
		{name: "branch terminal value", root: hashBytes(branchWithValue(rlp.EncodeBytes([]byte("terminal")))), key: []byte{}, proof: [][]byte{branchWithValue(rlp.EncodeBytes([]byte("terminal")))}, wantFound: true, wantValue: []byte("terminal")},
		{name: "extension child is list", root: hashBytes(rawNode(extensionPath([]byte{0x0a, 0x0b}), rlp.EncodeList())), key: []byte{0xab}, proof: [][]byte{rawNode(extensionPath([]byte{0x0a, 0x0b}), rlp.EncodeList())}, err: ErrUnexpectedNode},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			var rootHash [32]byte
			copy(rootHash[:], tt.root)

			got, err := verifyProof(rootHash, tt.key, buildProofDb(tt.proof))
			if !errors.Is(err, tt.err) {
				t.Fatalf("verifyProof: got err %v want %v", err, tt.err)
			}
			if err != nil {
				return
			}
			gotFound := got != nil
			if gotFound != tt.wantFound || !bytes.Equal(got, tt.wantValue) {
				t.Fatalf("verifyProof: got found=%v value=%x want found=%v value=%x", gotFound, got, tt.wantFound, tt.wantValue)
			}
		})
	}
}

func TestDecodeRef(t *testing.T) {
	embeddedLeaf := rawNode(leafPath(nil), rlp.EncodeBytes([]byte("dog")))
	embeddedValue, err := rlp.DecodeValue(embeddedLeaf)
	if err != nil {
		t.Fatalf("decode embedded fixture: %v", err)
	}

	hashedNode := rawNode(leafPath([]byte{0x0b}), rlp.EncodeBytes([]byte("wrapped")))
	hashedRef := hash(hashedNode)

	tests := []struct {
		name     string
		child    rlp.Value
		wantNode node
		err      error
	}{
		{name: "empty child", child: rlp.Value{Kind: rlp.KindString, Bytes: nil}, wantNode: nil},
		{name: "hashed child", child: rlp.Value{Kind: rlp.KindString, Bytes: hashedRef[:]}, wantNode: hashNode(hashedRef[:])},
		{name: "invalid short reference", child: rlp.Value{Kind: rlp.KindString, Bytes: []byte{0x01, 0x02, 0x03}}, err: ErrInvalidReference},
		{name: "invalid long reference", child: rlp.Value{Kind: rlp.KindString, Bytes: append(append([]byte{}, hashedRef[:]...), 0x00)}, err: ErrInvalidReference},
		{name: "embedded child", child: embeddedValue, wantNode: nil}, // checked separately below
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got, err := decodeRef(tt.child)
			if !errors.Is(err, tt.err) {
				t.Fatalf("decodeRef: got err %v want %v", err, tt.err)
			}
			if err != nil {
				return
			}
			if tt.name == "embedded child" {
				sn, ok := got.(*shortNode)
				if !ok {
					t.Fatalf("decodeRef: got %T, want *shortNode", got)
				}
				if val, ok := sn.Val.(valueNode); !ok || !bytes.Equal(val, []byte("dog")) {
					t.Fatalf("decodeRef: got shortNode.Val=%v, want valueNode(dog)", sn.Val)
				}
				return
			}
			if hn, ok := tt.wantNode.(hashNode); ok {
				gotHn, ok := got.(hashNode)
				if !ok || !bytes.Equal(gotHn, hn) {
					t.Fatalf("decodeRef: got %v want %v", got, hn)
				}
				return
			}
			if got != nil {
				t.Fatalf("decodeRef: got %v want nil", got)
			}
		})
	}
}

// TestDecodeRefAcceptsOversizedEmbeddedNode pins a known, documented
// divergence: go-ethereum's decodeRef rejects an embedded (List-kind) child
// whose own RLP encoding is >= 32 bytes ("oversized embedded node"), but
// decodeRef has no such check (see its doc comment for why). A proof like
// this would fail against real go-ethereum but succeeds here.
func TestDecodeRefAcceptsOversizedEmbeddedNode(t *testing.T) {
	oversizedValue := bytes.Repeat([]byte{0x99}, 40)
	oversizedLeaf := rawNode(leafPath([]byte{0x03, 0x04, 0x05}), rlp.EncodeBytes(oversizedValue))
	if len(oversizedLeaf) <= 32 {
		t.Fatalf("fixture too small to be oversized: %d bytes", len(oversizedLeaf))
	}

	branchChildren := emptyBranch()
	branchChildren[0x0a] = oversizedLeaf
	branch := rlp.EncodeList(branchChildren...)

	if err := Verify(hashBytes(branch), []byte{0xa3, 0x45}, oversizedValue, [][]byte{branch}); err != nil {
		t.Fatalf("Verify: got %v, want nil (oversized embedded node is accepted)", err)
	}
}

func TestKeybytesToHex(t *testing.T) {
	tests := []struct {
		name string
		key  []byte
		want []byte
	}{
		{name: "empty", key: nil, want: []byte{16}},
		{name: "single byte", key: []byte{0xab}, want: []byte{0x0a, 0x0b, 16}},
		{name: "two bytes", key: []byte{0x01, 0xf0}, want: []byte{0x00, 0x01, 0x0f, 0x00, 16}},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if got := keybytesToHex(tt.key); !bytes.Equal(got, tt.want) {
				t.Fatalf("keybytesToHex: got %x want %x", got, tt.want)
			}
		})
	}
}

func TestHasTerm(t *testing.T) {
	tests := []struct {
		name string
		s    []byte
		want bool
	}{
		{name: "empty", s: nil, want: false},
		{name: "no terminator", s: []byte{0x0a, 0x0b}, want: false},
		{name: "terminator", s: []byte{0x0a, 0x0b, 16}, want: true},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if got := hasTerm(tt.s); got != tt.want {
				t.Fatalf("hasTerm: got %v want %v", got, tt.want)
			}
		})
	}
}

// TestCompactToHex pins values cross-checked against a standalone run of
// go-ethereum's actual compactToHex/keybytesToHex (v1.10.26). Note it has no
// error path at all: malformed compact encodings (bad flag nibble, nonzero
// padding, empty extension path) aren't rejected, they just fold into some
// other (still deterministic) hex key that won't match a real lookup key.
func TestCompactToHex(t *testing.T) {
	tests := []struct {
		name    string
		encoded []byte
		want    []byte
	}{
		{name: "empty input", encoded: nil, want: nil},
		{name: "invalid flag", encoded: []byte{0x40}, want: []byte{16}},
		{name: "even path low nibble nonzero", encoded: []byte{0x01}, want: []byte{}},
		{name: "empty extension", encoded: extensionPath(nil), want: []byte{}},
		{name: "empty leaf", encoded: leafPath(nil), want: []byte{16}},
		{name: "odd extension", encoded: extensionPath([]byte{0x0a, 0x0b, 0x0c}), want: []byte{0x0a, 0x0b, 0x0c}},
		{name: "odd leaf", encoded: leafPath([]byte{0x0a, 0x0b, 0x0c}), want: []byte{0x0a, 0x0b, 0x0c, 16}},
		{name: "even leaf", encoded: leafPath([]byte{0x01, 0x02}), want: []byte{0x01, 0x02, 16}},
		{name: "even extension", encoded: extensionPath([]byte{0x01, 0x02}), want: []byte{0x01, 0x02}},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := compactToHex(tt.encoded)
			if !bytes.Equal(got, tt.want) {
				t.Fatalf("compactToHex: got %x want %x", got, tt.want)
			}
		})
	}
}
